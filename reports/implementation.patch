+/* ===========================================================================
+   Case-study stepper: step tabs on top, prev/next at the bottom
+   =========================================================================== */
+
+/* 시트 안 미디어 스트립: 스크롤 컨테이너로 두면 시트 본문 그리드가 이 행의 높이를 0으로 계산해
+   이미지가 잘린다. 스크롤 대신 폭에 맞춰 줄바꿈하는 그리드로 바꾸고, 높이는 이미지의 고유 비율에서 얻는다. */
+.sheet .media-strip {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
+  gap: 0.75rem;
+  align-items: start;
+  height: auto;
+  max-height: none;
+  overflow: visible;
+  padding: 0;
+}
+
+.sheet .media-strip > .media-button {
+  width: 100%;
+  height: auto;
+  aspect-ratio: auto;
+}
+
+.sheet .media-strip > .media-button img {
+  height: auto;
+}
+
+/* step tabs — every step listed in order, current one underlined */
+.case-steps {
+  overflow-x: auto;
+  border-bottom: 1px solid rgba(23, 27, 24, 0.14);
+  padding: 0 clamp(1.2rem, 4vw, 2.4rem);
+  background: var(--surface);
+  scrollbar-width: none;
+}
+
+.case-steps-list {
+  display: flex;
+  gap: 0.25rem;
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+
+.case-step {
+  display: inline-flex;
+  align-items: center;
+  gap: 0.5rem;
+  border: 0;
+  border-bottom: 2px solid transparent;
+  border-radius: 0;
+  padding: 0.8rem 0.7rem 0.7rem;
+  background: transparent;
+  color: var(--muted);
+  font-family: var(--mono);
+  font-size: 0.64rem;
+  font-weight: 600;
+  letter-spacing: 0.06em;
+  text-transform: uppercase;
+  white-space: nowrap;
+  cursor: pointer;
+  transition:
+    color 140ms ease,
+    border-color 140ms ease;
+}
+
+.case-step-index {
+  color: rgba(23, 27, 24, 0.4);
+}
+
+.case-step:hover {
+  color: var(--ink);
+}
+
+.case-step:focus-visible {
+  outline: 2px solid var(--blue);
+  outline-offset: -2px;
+}
+
+.case-step.is-done .case-step-index {
+  color: var(--blue);
+}
+
+.case-step.is-active {
+  border-bottom-color: var(--blue);
+  color: var(--ink);
+}
+
+.case-step.is-active .case-step-index {
+  color: var(--blue);
+}
+
+.case-step-controls {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 1rem;
+  border-top: 1px solid rgba(23, 27, 24, 0.14);
+  padding: 0.65rem clamp(1.2rem, 4vw, 2.4rem);
+  background: var(--surface);
+}
+
+.case-step-btn {
+  display: inline-flex;
+  align-items: center;
+  gap: 0.5rem;
+  height: 34px;
+  border: 1px solid rgba(23, 27, 24, 0.3);
+  border-radius: 0;
+  padding: 0 0.9rem;
+  background: transparent;
+  color: var(--ink);
+  font-family: var(--mono);
+  font-size: 0.66rem;
+  font-weight: 600;
+  letter-spacing: 0.06em;
+  text-transform: uppercase;
+  cursor: pointer;
+  transition:
+    border-color 150ms ease,
+    background 150ms ease,
+    color 150ms ease;
+}
+
+.case-step-btn:hover,
+.case-step-btn:focus-visible {
+  border-color: var(--blue);
+  background: var(--blue);
+  color: #fff;
+  outline: none;
+}
+
+.case-step-btn:disabled {
+  border-color: rgba(23, 27, 24, 0.14);
+  background: transparent;
+  color: rgba(23, 27, 24, 0.3);
+  cursor: default;
+}
+
+.case-step-btn.is-primary {
+  border-color: var(--ink);
+  background: var(--ink);
+  color: var(--paper);
+}
+
+.case-step-btn.is-primary:hover,
+.case-step-btn.is-primary:focus-visible {
+  border-color: var(--blue);
+  background: var(--blue);
+  color: #fff;
+}
+
+.case-step-count {
+  color: var(--muted);
+  font-family: var(--mono);
+  font-size: 0.66rem;
+  font-weight: 600;
+  letter-spacing: 0.06em;
+}
+
+@media (max-width: 760px) {
+  .case-steps {
+    padding: 0 0.9rem;
+  }
+
+  .case-step-controls {
+    padding: 0.55rem 0.9rem;
+  }
+
+  .case-step-label {
+    display: none;
+  }
+
+  .case-step.is-active .case-step-label {
+    display: inline;
+  }
+}
