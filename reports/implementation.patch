+}
+
+.case-section-header > p:last-child {
+  max-width: 790px;
+  margin: 0;
+  color: var(--fg-2);
+  font-size: 0.96rem;
+  line-height: 1.72;
+}
+
+.case-section-kicker {
+  margin: 0 0 0.35rem;
+  color: var(--blue);
+  font-family: var(--mono);
+  font-size: 0.64rem;
+  font-weight: 500;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+}
+
+.case-rule-note {
+  display: grid;
+  grid-template-columns: minmax(130px, 0.24fr) minmax(0, 1fr);
+  gap: 1rem;
+  align-items: start;
+  margin-top: 0.8rem;
+  border-left: 4px solid var(--blue);
+  padding: 0.9rem 1rem;
+  background: var(--paper);
+}
+
+.case-rule-note > span {
+
+  color: var(--blue);
+  font-family: var(--mono);
+  font-size: 0.64rem;
+  font-weight: 500;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+}
+
+.case-rule-note p {
+  margin: 0;
+  color: var(--fg-2);
+  font-size: 0.88rem;
+}
+
+.payload-map {
+  border: 1px solid var(--line);
+  border-radius: var(--radius);
+  padding: clamp(1rem, 3vw, 1.5rem);
+  background: var(--paper);
+}
+
+.payload-root {
+  width: min(330px, 100%);
+  margin-inline: auto;
+  border: 2px solid var(--ink);
+  border-radius: var(--radius-sm);
+  padding: 0.75rem 1rem;
