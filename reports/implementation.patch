+
+.payload-root span,
+.payload-node span,
+.payload-impact > span {
+  display: block;
+  margin-bottom: 0.15rem;
+  color: var(--muted);
+  font-family: var(--mono);
+  font-size: 0.6rem;
+  font-weight: 500;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+}
+
+.payload-root span {
+  color: var(--tint-ink);
+}
+
+.payload-root strong,
+.payload-node strong {
+  display: block;
