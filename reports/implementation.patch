+  line-height: 1.45;
+}
+
+.payload-impact p {
+  margin: 0.35rem 0 0;
+  color: rgba(255, 255, 255, 0.7);
+  font-size: 0.82rem;
+}
+
+.code-change-grid {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: 0.8rem;
+}
+
+.code-change-grid.is-three {
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+}
+
+.code-card {
+  min-width: 0;
+  overflow: hidden;
+  border: 1px solid var(--ink);
