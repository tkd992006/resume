+
+.code-card header span {
+  display: block;
+  margin-bottom: 0.15rem;
+  color: var(--tint-ink);
+  font-family: var(--mono);
+  font-size: 0.6rem;
+  font-weight: 500;
+  letter-spacing: 0.08em;
