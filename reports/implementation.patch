+.payload-branches {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: 0.85rem;
+}
+
+.payload-branch {
+  min-width: 0;
+  border: 1px solid var(--line);
+  border-top: 4px solid var(--coral);
