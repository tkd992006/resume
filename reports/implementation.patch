+  --muted: #676d68;
+  --paper: #e7e8e2;
+  --surface: #f3f4ef;
+  --line: #c6cac3;
+  --edge: rgba(23, 27, 24, 0.12);
+  --edge-2: rgba(23, 27, 24, 0.28);
+  --blue: #2d4bd2;
+  --tint: #dbe1ff; /* cobalt tint on paper: chips, "after" states */
+  --tint-ink: #9eafff; /* cobalt tint on ink backgrounds */
+  --wash: #e9ecf8; /* faint cobalt wash for outcome cards */
+  --coral: #ff6846;
+  --coral-ink: #a34029;
+  --coral-wash: #fbefea;
+  --shadow: 0 18px 50px rgba(23, 27, 24, 0.08);
+  --radius: 6px;
+  --radius-sm: 4px;
+  --text-max: 720px;
+  /* 셸 콘텐츠 최대 폭: rail 236px + stage padding 2 × 2.75rem + panel 1120px */
+  --shell-max: calc(236px + 5.5rem + 1120px);
+  --display: "Archivo", "Pretendard Variable", Pretendard, sans-serif;
+  --mono: "IBM Plex Mono", ui-monospace, "SF Mono", Menlo, Consolas, monospace;
+}
+
+* {
+  box-sizing: border-box;
+}
+
+html,
+body {
+  height: 100%;
+}
+
+body {
+  margin: 0;
+  background:
+    linear-gradient(rgba(23, 27, 24, 0.018) 1px, transparent 1px),
+    var(--paper);
+  background-size: 100% 8px;
+  color: var(--ink);
+  font-family: "Pretendard Variable", Pretendard, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
+  font-size: 14px;
+  line-height: 1.6;
+  word-break: keep-all;
+}
+
+img {
+  display: block;
+  max-width: 100%;
+  height: auto;
+}
+
+a {
+  color: inherit;
+  text-decoration: none;
+}
+
+button {
+  font: inherit;
+}
+
+h1,
+h2,
+h3,
+h4,
+p {
+  margin-top: 0;
+}
+
+.mono {
+  font-family: var(--mono);
+  font-size: 0.64rem;
+  font-weight: 500;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+}
+
+.display {
+  font-family: var(--display);
+  font-variation-settings: "wdth" 94;
+  font-weight: 660;
+  letter-spacing: -0.04em;
+}
+
+.sr-only {
+  position: absolute;
+  width: 1px;
+  height: 1px;
+  overflow: hidden;
+  clip: rect(0 0 0 0);
+  white-space: nowrap;
+}
+
+.skip-link {
+  position: absolute;
+  top: -100px;
+  left: 1rem;
+  z-index: 100;
+  padding: 0.5rem 0.9rem;
+  background: var(--ink);
+  color: var(--paper);
+  font-family: var(--mono);
+  font-size: 0.7rem;
+  text-transform: uppercase;
+}
+
+.skip-link:focus-visible {
+  top: 0.75rem;
+  outline: 2px solid var(--blue);
+}
+
+/* ---------------------------------------------------------------------------
+   App shell — masthead / chrono / workspace fill the viewport
+--------------------------------------------------------------------------- */
+
+.app {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr);
+  grid-template-rows: auto auto minmax(0, 1fr);
+  height: 100dvh;
+  overflow: hidden;
+}
+
+.masthead {
+  display: flex;
+  align-items: flex-end;
+  justify-content: space-between;
+  gap: 1.5rem;
+  border-bottom: 1px solid rgba(23, 27, 24, 0.22);
+  /* 워크스페이스와 같은 폭 안에 이름·연락처를 모은다 (구분선은 화면 전체 폭 유지) */
+  padding: 1rem max(1.75rem, calc((100% - var(--shell-max)) / 2)) 0.85rem;
+}
+
+.masthead-name {
+  margin: 0 0 0.35rem;
+  font-family: var(--display);
+  font-size: clamp(2.2rem, 3.6vw, 3rem);
+  font-variation-settings: "wdth" 100;
+  font-weight: 720;
+  letter-spacing: -0.045em;
+  line-height: 0.9;
+  text-transform: uppercase;
+}
+
+.masthead-name small {
+  margin-left: 0.7rem;
+  font-family: var(--mono);
+  font-size: 0.66rem;
+  font-weight: 500;
+  letter-spacing: 0.1em;
+  vertical-align: 0.5em;
+  color: var(--muted);
+  text-transform: none;
+}
+
+.masthead-meta {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.2rem 1.25rem;
+  margin: 0;
+  color: var(--muted);
+}
+
+.masthead-meta span {
+  min-width: 0;
+}
+
+.masthead-meta strong {
+  color: var(--ink);
+  font-weight: 600;
+}
+
+.masthead-side {
+  display: grid;
+  gap: 0.3rem;
+  justify-items: end;
+  color: var(--ink);
+  text-align: right;
+}
+
+.masthead-side a {
+  border-bottom: 1px solid rgba(23, 27, 24, 0.3);
+  transition:
+    color 140ms ease,
+    border-color 140ms ease;
+}
+
+.masthead-side a:hover,
+.masthead-side a:focus-visible {
+  border-color: var(--blue);
+  color: var(--blue);
+  outline: none;
+}
+
+/* ---------------------------------------------------------------------------
+   연표 — narrower chart on the left, caption on the right
+--------------------------------------------------------------------------- */
+
+.chrono {
+  position: relative;
+  display: grid;
+  grid-template-columns: minmax(0, 820px) auto;
+  justify-content: center;
+  gap: 1rem 2.5rem;
+  align-items: start;
+  min-width: 0;
+  border-bottom: 1px solid rgba(23, 27, 24, 0.22);
+  padding: 1.1rem 1.75rem 0.85rem;
+}
+
+.chrono-main {
+  min-width: 0;
+  max-width: 820px;
+}
+
+.chrono-side {
+  display: grid;
+  gap: 0.45rem;
+  justify-items: end;
+  padding-top: 0.15rem;
+  text-align: right;
+}
+
+.chrono-hint {
+  margin: 0;
+  color: var(--muted);
+}
+
+.chrono-scroller {
+  overflow-x: auto;
+  scrollbar-width: thin;
+}
+
+.chrono-grid {
+  --row: 9px;
+  position: relative;
+  display: grid;
+  grid-template-columns: var(--chrono-label, 104px) var(--chrono-months, repeat(75, minmax(0, 1fr)));
+  /* 첫 행(연도 라벨)은 글자 높이보다 넉넉히 잡아 overflow 클리핑을 막는다 */
+  grid-template-rows: 18px;
+  grid-auto-rows: var(--row);
+  row-gap: 6px;
+  min-width: 620px;
+  padding: 0.2rem 0;
+}
+
+.chrono-fallback {
+  grid-column: 1 / -1;
+  margin: 0;
+  color: var(--muted);
+  font-family: var(--mono);
+  font-size: 0.68rem;
+}
+
+.chrono-year {
+  grid-row: 1;
+  z-index: 1;
+  align-self: end;
+  border-left: 1px solid rgba(23, 27, 24, 0.3);
+  padding: 0 0 0.1rem 0.35rem;
+  color: var(--muted);
+  font-family: var(--mono);
+  font-size: 0.6rem;
+  letter-spacing: 0.06em;
+  line-height: 1;
+}
+
+.chrono-yearline {
+  z-index: 1;
+  border-left: 1px solid rgba(23, 27, 24, 0.12);
+  pointer-events: none;
+}
+
+.chrono-lane {
+  grid-column: 1 / -1;
+  z-index: 0;
+  border-top: 1px dotted rgba(23, 27, 24, 0.22);
+  pointer-events: none;
+}
+
+.chrono-track {
+  grid-column: 1;
+  position: sticky;
+  left: 0;
+  z-index: 3;
+  align-self: start;
+  padding-right: 0.6rem;
+  background: var(--paper);
+  color: var(--ink);
+  font-family: var(--mono);
+  font-size: 0.6rem;
+  letter-spacing: 0.08em;
+  line-height: var(--row);
+  text-transform: uppercase;
+  white-space: nowrap;
+}
+
+/* 사건이 없는 2019–2021 단절 */
+.chrono-gap {
+  position: relative;
+  z-index: 5;
+  pointer-events: none;
+}
+
+.chrono-gap::before {
+  position: absolute;
+  top: 0.9rem;
+  bottom: 0;
+  left: 50%;
+  width: 9px;
+  border-right: 1px solid rgba(23, 27, 24, 0.28);
+  border-left: 1px solid rgba(23, 27, 24, 0.28);
+  background: var(--paper);
+  content: "";
+  transform: translateX(-50%) skewX(-9deg);
+}
+
+.chrono-gap::after {
+  position: absolute;
+  top: -0.05rem;
+  left: 50%;
+  padding: 0 0.15rem;
+  background: var(--paper);
+  color: var(--muted);
+  font-family: var(--mono);
+  font-size: 0.6rem;
+  letter-spacing: -0.12em;
+  content: "//";
+  transform: translateX(-50%);
+}
+
+.chrono-bar {
+  position: relative;
+  z-index: 2;
+  display: block;
+  height: var(--row);
+  border-radius: 1px;
+  background: rgba(23, 27, 24, 0.3);
+  transition:
+    opacity 140ms ease,
+    box-shadow 140ms ease,
+    transform 140ms ease;
+}
+
+.chrono-bar.is-featured {
+  background: var(--ink);
+}
+
+.chrono-bar.is-approx {
+  background: repeating-linear-gradient(90deg, rgba(23, 27, 24, 0.32) 0 6px, transparent 6px 10px);
+}
+
+.chrono-bar.is-ongoing {
+  background: linear-gradient(90deg, var(--blue) 0%, var(--blue) 55%, rgba(45, 75, 210, 0.08) 100%);
+}
+
+.chrono-bar.is-dot {
+  justify-self: center;
+  width: var(--row);
+  border: 1.5px solid var(--ink);
+  border-radius: 50%;
+  background: var(--surface);
+}
+
+.chrono-bar.is-dot.is-featured {
+  background: var(--ink);
+}
+
+.chrono-bar:hover,
+.chrono-bar:focus-visible {
+  z-index: 4;
+  outline: none;
+  box-shadow: 0 0 0 2px rgba(45, 75, 210, 0.45);
+  transform: translateY(-1px);
+}
+
+.chrono-grid.is-hovering .chrono-bar:not(.is-hot) {
+  opacity: 0.35;
+}
+
+.chrono-now {
+  position: relative;
+  z-index: 1;
+  border-left: 1px dashed var(--blue);
+  pointer-events: none;
+}
+
+.chrono-now::after {
+  position: absolute;
+  top: -0.1rem;
+  left: 4px;
+  color: var(--blue);
+  font-family: var(--mono);
+  font-size: 0.56rem;
+  letter-spacing: 0.1em;
+  text-transform: uppercase;
+  content: "now";
+}
+
+.chrono-legend {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.3rem 1.2rem;
+  margin: 0.55rem 0 0;
+  padding: 0;
+  color: var(--muted);
+  list-style: none;
+}
+
+.chrono-legend li {
+  display: inline-flex;
+  align-items: center;
+  gap: 0.45rem;
+}
+
+.lg-bar,
+.lg-dot {
+  display: inline-block;
+  width: 18px;
+  height: 6px;
+  border-radius: 1px;
+  background: rgba(23, 27, 24, 0.3);
+}
+
+.lg-bar.is-featured {
+  background: var(--ink);
+}
+
+.lg-bar.is-ongoing {
+  background: linear-gradient(90deg, var(--blue), rgba(45, 75, 210, 0.12));
+}
+
+.lg-dot {
+  width: 7px;
+  height: 7px;
+  border: 1.5px solid var(--ink);
+  border-radius: 50%;
+  background: var(--surface);
+}
+
+.chrono-tip {
+  position: fixed;
+  z-index: 60;
+  display: grid;
+  gap: 0.15rem;
+  max-width: 320px;
+  border: 1px solid rgba(23, 27, 24, 0.3);
+  padding: 0.5rem 0.7rem;
+  background: var(--surface);
+  box-shadow: 0 14px 34px rgba(23, 27, 24, 0.18);
+  pointer-events: none;
+  transform: translate(-50%, calc(-100% - 10px));
+}
+
+.chrono-tip strong {
+  font-family: "Pretendard Variable", Pretendard, ui-sans-serif, sans-serif;
+  font-size: 0.8rem;
+  font-weight: 700;
+  letter-spacing: 0;
+  text-transform: none;
+}
+
+.chrono-tip span {
+  color: var(--muted);
+}
+
+.chrono-tip[hidden] {
+  display: none;
+}
+
+/* ---------------------------------------------------------------------------
+   Workspace — index rail + stage
+--------------------------------------------------------------------------- */
+
+.workspace {
+  display: grid;
+  grid-template-columns: 236px minmax(0, 1fr);
+  justify-self: center;
+  width: 100%;
+  max-width: var(--shell-max);
+  min-width: 0;
+  min-height: 0;
+}
+
+.rail {
+  display: flex;
+  flex-direction: column;
+  min-height: 0;
+  overflow: auto;
+  border-right: 1px solid rgba(23, 27, 24, 0.2);
+  padding: 1.2rem 0.9rem 1rem;
+  scrollbar-width: thin;
+}
+
+.rail-label {
+  margin: 0 0 0.85rem;
+  padding: 0 0.6rem;
+  color: var(--muted);
+}
+
+.rail-list {
+  display: grid;
+  gap: 0.15rem;
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+
+.rail-link {
+  display: grid;
+  grid-template-columns: auto minmax(0, 1fr);
+  gap: 0.05rem 0.75rem;
+  align-items: baseline;
+  padding: 0.6rem 0.75rem 0.65rem;
+  color: var(--muted);
+  transition:
+    background 140ms ease,
+    color 140ms ease;
+}
+
+.rail-index {
+  grid-row: 1 / span 2;
+  align-self: start;
+  padding-top: 0.2rem;
+  color: var(--muted);
+}
+
+.rail-link:hover,
+.rail-link:focus-visible {
+  background: rgba(23, 27, 24, 0.06);
+  color: var(--ink);
+  outline: none;
+}
+
+.rail-item.is-active .rail-link {
+  background: var(--ink);
+  color: rgba(231, 232, 226, 0.7);
+}
+
+.rail-item.is-active .rail-index {
+  color: var(--tint-ink);
+}
+
+.rail-title {
+  color: var(--ink);
+  font-family: var(--mono);
+  font-size: 0.74rem;
+  font-weight: 600;
+  letter-spacing: 0.04em;
+  line-height: 1.35;
+  text-transform: uppercase;
+}
+
+.rail-item.is-active .rail-title {
+  color: var(--paper);
+}
+
+.rail-note {
+  font-size: 0.7rem;
+  line-height: 1.4;
+}
+
+.rail-foot {
+  margin: auto 0 0;
+  padding: 0.9rem 0.6rem 0;
+  color: var(--muted);
+}
+
+.stage {
+  min-height: 0;
+  overflow: auto;
+  padding: 1.25rem clamp(1.25rem, 3vw, 2.75rem) 1.5rem;
+  scrollbar-width: thin;
+}
+
+.stage:focus,
+.panel:focus {
+  outline: none;
+}
+
+.panel {
+  display: none;
+  width: min(1120px, 100%);
+  margin: 0 auto;
+}
+
+.panel.is-active {
+  display: grid;
+  gap: 1.15rem;
+}
+
+.block {
+  display: grid;
+  gap: 0.7rem;
+}
+
+.block-head {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: baseline;
+  justify-content: space-between;
+  gap: 0.35rem 1rem;
+}
+
+.block-head h2 {
+  margin: 0;
+  font-family: var(--display);
+  font-size: 1.4rem;
+  font-variation-settings: "wdth" 94;
+  font-weight: 660;
+  letter-spacing: -0.035em;
+  line-height: 1.1;
+}
+
+.block-lead {
+  margin: 0;
+  color: var(--muted);
+  font-size: 0.78rem;
+}
+
+.eyebrow {
+  margin: 0 0 0.3rem;
+  color: var(--blue);
+}
+
+.is-targeted {
+  animation: target-pulse 1.6s ease;
+}
+
+@keyframes target-pulse {
+  0%,
+  35% {
+    box-shadow: 0 0 0 2px var(--blue);
+  }
+
+  100% {
+    box-shadow: 0 0 0 2px transparent;
+  }
+}
+
+/* ---------------------------------------------------------------------------
+   Who Am I
+--------------------------------------------------------------------------- */
+
+.intro {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) minmax(260px, 0.72fr);
+  gap: 2rem;
+  align-items: center;
+  overflow: hidden;
+  border: 1px solid var(--line);
+  border-radius: var(--radius);
+  padding: 1.25rem 1.6rem;
+  background: var(--surface);
+  box-shadow: var(--shadow);
+}
+
+.intro-lead {
+  max-width: 560px;
+  margin: 0;
+  color: var(--fg-2);
+  font-size: 0.92rem;
+  line-height: 1.7;
+}
+
+.intro-lead strong {
+  color: var(--ink);
+  font-weight: 700;
+}
+
+.hero-media {
+  position: relative;
+  height: 150px;
+  pointer-events: none;
+}
+
+.hero-shot {
+  position: absolute;
+  border: 1px solid rgba(23, 27, 24, 0.14);
+  border-radius: var(--radius-sm);
+  box-shadow: 0 16px 40px rgba(23, 27, 24, 0.2);
+  object-fit: cover;
+}
+
+.shot-a {
+  z-index: 5;
+  left: 30%;
+  top: 0;
+  width: 25%;
+  aspect-ratio: 520 / 1128;
+  transform: rotate(-2.5deg);
+}
+
+.shot-b {
+  z-index: 6;
+  left: 4%;
+  top: 12%;
+  width: 22%;
+  aspect-ratio: 520 / 1136;
+  transform: rotate(3deg);
+}
+
+.shot-c {
+  z-index: 1;
+  right: 0;
+  top: 16%;
+  width: 58%;
+  aspect-ratio: 1400 / 814;
+  transform: rotate(1.5deg);
+}
+
+.shot-d {
+  z-index: 2;
+  right: 6%;
+  bottom: 0;
+  width: 44%;
+  aspect-ratio: 16 / 9;
+  transform: rotate(-2deg);
+}
+
+.facts {
+  display: grid;
+  gap: 0.3rem;
+  margin-top: 0.9rem;
+  border-top: 1px solid var(--line);
+  padding-top: 0.75rem;
+}
+
+.fact {
+  display: grid;
+  grid-template-columns: 82px minmax(0, 1fr);
+  gap: 0.75rem;
+  align-items: baseline;
+}
+
+.fact span {
+  color: var(--muted);
+}
+
+.fact strong {
+  color: var(--fg-2);
+  font-size: 0.78rem;
+  font-weight: 600;
+  line-height: 1.5;
+}
+
+/* AMA */
+
+.ama-panel {
+  display: grid;
+  grid-template-columns: minmax(220px, 0.36fr) minmax(0, 1fr);
+  gap: 0.6rem;
+}
+
+.ama-questions {
+  display: grid;
+  gap: 0.35rem;
+  align-content: start;
+}
+
+.ama-question {
+  display: flex;
+  align-items: center;
+  min-height: 42px;
+  border: 1px solid var(--line);
+  border-radius: var(--radius);
+  padding: 0.55rem 0.85rem;
+  background: var(--surface);
+  color: var(--ink);
+  font-size: 0.82rem;
+  font-weight: 700;
+  text-align: left;
+  cursor: pointer;
+  transition:
+    border-color 140ms ease,
+    background 140ms ease,
+    color 140ms ease;
+}
+
+.ama-question:hover,
+.ama-question:focus-visible {
+  border-color: var(--ink);
+  outline: none;
+}
+
+.ama-question.is-active {
+  border-color: var(--ink);
+  background: var(--ink);
+  color: var(--paper);
+}
+
+.ama-question.is-active::after {
+  margin-left: auto;
+  color: var(--tint-ink);
+  content: "→";
+}
+
+.ama-answer {
+  border: 1px solid var(--line);
+  border-radius: var(--radius);
+  padding: 1rem 1.2rem 1.1rem;
+  background: var(--surface);
+}
+
+.ama-answer .project-kicker {
+  margin-bottom: 0.4rem;
+  color: var(--blue);
+}
+
+.ama-answer h3 {
+  margin: 0 0 0.45rem;
+  font-size: 1rem;
+  font-weight: 700;
+  letter-spacing: -0.01em;
+  line-height: 1.35;
+}
+
+.ama-answer > p:not(.project-kicker) {
+  margin: 0;
+  color: var(--fg-2);
+  font-size: 0.82rem;
+  line-height: 1.65;
+}
+
+.ama-followups {
+  display: grid;
+  gap: 0.3rem;
+  margin-top: 0.75rem;
+}
+
+.ama-followup {
+  overflow: hidden;
+  border-radius: var(--radius-sm);
+  background: rgba(23, 27, 24, 0.05);
+}
+
+.ama-followup.is-open {
+  background: rgba(23, 27, 24, 0.08);
+}
+
+.ama-followup-toggle {
+  display: flex;
+  align-items: center;
+  width: 100%;
+  min-height: 30px;
+  border: 0;
+  padding: 0.3rem 0.7rem;
+  background: transparent;
+  color: var(--ink);
+  font-size: 0.76rem;
+  font-weight: 700;
+  text-align: left;
+  cursor: pointer;
+}
+
+.ama-followup-toggle:focus-visible {
+  outline: 2px solid var(--blue);
+  outline-offset: -2px;
+}
+
+.ama-followup-toggle::after {
+  margin-left: auto;
+  color: var(--muted);
+  font-weight: 700;
+  content: "+";
+  transition: transform 160ms ease;
+}
+
+.ama-followup.is-open .ama-followup-toggle::after {
+  transform: rotate(45deg);
+}
+
+.ama-followup-answer {
+  display: grid;
+  grid-template-rows: 0fr;
+  opacity: 0;
+  visibility: hidden;
+  transition:
+    grid-template-rows 220ms ease,
+    opacity 160ms ease,
+    visibility 0s linear 220ms;
+}
+
+.ama-followup.is-open .ama-followup-answer {
+  grid-template-rows: 1fr;
+  opacity: 1;
+  visibility: visible;
+  transition:
+    grid-template-rows 220ms ease,
+    opacity 160ms ease,
+    visibility 0s linear;
+}
+
+.ama-followup-answer > div {
+  min-height: 0;
+  overflow: hidden;
+}
+
+.ama-followup-answer p {
+  margin: 0;
+  padding: 0 0.7rem 0.6rem;
+  color: var(--fg-2);
+  font-size: 0.78rem;
+  line-height: 1.6;
+}
+
+/* ---------------------------------------------------------------------------
+   AI Experience
+--------------------------------------------------------------------------- */
+
+.ai-card {
+  display: grid;
+  grid-template-columns: minmax(220px, 0.34fr) minmax(0, 1fr);
+  gap: 1.5rem;
+  border: 1px solid var(--line);
+  border-radius: var(--radius);
+  padding: 1.25rem 1.5rem;
+  background: var(--surface);
+}
+
+.ai-timeline {
+  position: relative;
+  display: grid;
+  gap: 0.35rem;
+  align-content: start;
+  padding-left: 1.1rem;
+}
+
+.ai-timeline::before {
+  position: absolute;
+  top: 0.7rem;
+  bottom: 0.7rem;
+  left: 4px;
+  width: 1px;
+  background: rgba(23, 27, 24, 0.25);
+  content: "";
+}
+
+.ai-timeline span {
+  position: relative;
+  padding: 0.22rem 0;
+  color: var(--fg-2);
+  font-family: var(--mono);
+  font-size: 0.7rem;
+  font-weight: 500;
+}
+
+.ai-timeline span::before {
+  position: absolute;
+  top: 50%;
+  left: calc(1px - 1.1rem);
+  width: 7px;
+  height: 7px;
+  border: 1.5px solid var(--ink);
+  border-radius: 50%;
+  background: var(--surface);
+  box-shadow: 0 0 0 3px var(--surface);
+  transform: translateY(-50%);
+  content: "";
+}
+
+.ai-timeline span:last-child::before {
+  border-color: var(--blue);
+  background: var(--blue);
+}
+
+.ai-copy {
+  display: grid;
+  gap: 0.7rem;
+  color: var(--fg-2);
+  font-size: 0.84rem;
+  line-height: 1.65;
+}
+
+.ai-copy p {
+  margin: 0;
+}
+
+/* ---------------------------------------------------------------------------
+   Education + Work
+--------------------------------------------------------------------------- */
+
+.cards {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: 0.6rem;
+}
+
+.card {
+  border: 1px solid var(--line);
+  border-radius: var(--radius);
+  padding: 0.85rem 1.05rem;
+  background: var(--surface);
+}
+
+.card h3 {
+  margin: 0 0 0.2rem;
+  font-size: 0.92rem;
+  font-weight: 700;
+}
+
+.card p {
+  margin: 0;
+  color: var(--fg-2);
+  font-size: 0.78rem;
+  line-height: 1.55;
+}
+
+.card p + p {
+  margin-top: 0.1rem;
+  color: var(--muted);
+}
+
+.work-rows {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: 0.6rem;
+}
+
+.work-row {
+  display: grid;
+  gap: 0.35rem;
+  align-content: start;
+  border: 1px solid var(--line);
+  border-radius: var(--radius);
+  padding: 0.85rem 1.05rem;
+  background: var(--surface);
+}
+
+.work-row .period {
+  padding-top: 0.2rem;
+  color: var(--muted);
+}
+
+.work-row h3 {
+  margin: 0;
+  font-family: var(--display);
+  font-size: 1.05rem;
+  font-variation-settings: "wdth" 96;
+  font-weight: 660;
+  letter-spacing: -0.02em;
+}
+
+.work-row .role {
+  margin: 0.1rem 0 0.35rem;
+  color: var(--blue);
+}
+
+.work-row p:last-child {
+  margin: 0;
+  color: var(--fg-2);
+  font-size: 0.8rem;
+  line-height: 1.55;
+}
+
+.skills {
+  display: grid;
+  grid-template-columns: repeat(4, minmax(0, 1fr));
+  gap: 0.6rem;
+}
+
+.skill {
+  border: 1px solid var(--line);
+  border-radius: var(--radius);
+  padding: 0.75rem 0.9rem;
+  background: var(--surface);
+}
+
+.skill h3 {
+  margin: 0 0 0.3rem;
+  color: var(--muted);
+}
+
+.skill p {
+  margin: 0;
+  color: var(--fg-2);
+  font-size: 0.76rem;
+  line-height: 1.5;
+}
+
+/* ---------------------------------------------------------------------------
+   Selected Work — compact rows, details in a sheet
+--------------------------------------------------------------------------- */
+
+.work-list {
+  display: grid;
+  gap: 0.5rem;
+}
+
+.work-item {
+  display: grid;
+  grid-template-columns: 124px minmax(0, 1fr) auto;
+  gap: 1rem;
+  align-items: center;
+  width: 100%;
+  border: 1px solid var(--line);
+  border-radius: var(--radius);
+  padding: 0.8rem 1.1rem;
+  background: var(--surface);
+  color: inherit;
+  text-align: left;
+  cursor: pointer;
+  transition:
+    border-color 140ms ease,
+    box-shadow 140ms ease;
+}
+
+.work-item:hover,
+.work-item:focus-visible {
+  border-color: var(--ink);
+  box-shadow: var(--shadow);
+  outline: none;
+}
+
+.work-item:focus-visible {
+  outline: 2px solid var(--blue);
+  outline-offset: 2px;
+}
+
+.work-item.is-feature {
+  border-color: rgba(45, 75, 210, 0.5);
+}
+
+.work-period {
+  color: var(--muted);
+}
+
+.work-main {
+  display: grid;
+  gap: 0.18rem;
+  min-width: 0;
+}
+
+.work-kicker {
+  color: var(--blue);
+}
+
+.work-title {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: baseline;
+  gap: 0.2rem 0.6rem;
+  font-family: var(--display);
+  font-size: 1.1rem;
+  font-variation-settings: "wdth" 96;
+  font-weight: 660;
+  letter-spacing: -0.025em;
+}
+
+.work-title small {
+  color: var(--muted);
+  font-family: "Pretendard Variable", Pretendard, ui-sans-serif, sans-serif;
+  font-size: 0.76rem;
+  font-weight: 600;
+  letter-spacing: 0;
+}
+
+.work-chips {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.3rem;
+  margin-top: 0.15rem;
+}
+
+.work-chips span {
+  padding: 0.12rem 0.5rem;
+  background: var(--tint);
+  color: var(--ink);
+  font-size: 0.66rem;
+  font-weight: 700;
+}
+
+.work-side {
+  display: flex;
+  align-items: center;
+  gap: 0.6rem;
+  white-space: nowrap;
+}
+
+.work-tag {
+  padding: 0.22rem 0.55rem;
+  background: var(--blue);
+  color: var(--paper);
+}
+
+.work-open {
+  color: var(--muted);
+}
+
+.work-open::after {
+  content: " ↗";
+}
+
+/* ---------------------------------------------------------------------------
+   Portfolio — compact cards, details in a sheet
+--------------------------------------------------------------------------- */
+
+.folio-grid {
+  display: grid;
+  grid-template-columns: repeat(4, minmax(0, 1fr));
+  gap: 0.65rem;
+}
+
+.folio-card {
+  display: grid;
+  gap: 0.5rem;
+  align-content: start;
+  width: 100%;
+  border: 1px solid var(--line);
+  border-radius: var(--radius);
+  padding: 0.55rem 0.55rem 0.7rem;
+  background: var(--surface);
+  color: inherit;
+  text-align: left;
+  cursor: pointer;
+  transition:
+    border-color 140ms ease,
+    box-shadow 140ms ease;
+}
+
+.folio-card:hover,
+.folio-card:focus-visible {
+  border-color: var(--ink);
+  box-shadow: var(--shadow);
+  outline: none;
+}
+
+.folio-card:focus-visible {
+  outline: 2px solid var(--blue);
+  outline-offset: 2px;
+}
+
+.folio-thumb {
+  display: grid;
+  overflow: hidden;
+  aspect-ratio: 16 / 10;
+  border-radius: var(--radius-sm);
+  background: var(--line);
+}
+
+.folio-thumb.two-up {
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+}
+
+.folio-thumb img {
+  width: 100%;
+  height: 100%;
+  object-fit: cover;
+}
+
+.folio-thumb.is-text {
+  place-items: center;
+  padding: 0.75rem;
+  color: var(--muted);
+  text-align: center;
+}
+
+.folio-title {
+  display: block;
+  padding: 0 0.3rem;
+  font-family: var(--display);
+  font-size: 0.95rem;
+  font-variation-settings: "wdth" 96;
+  font-weight: 660;
+  letter-spacing: -0.02em;
+}
+
+.folio-sub {
+  display: block;
+  padding: 0 0.3rem;
+  color: var(--muted);
+  font-size: 0.7rem;
+  line-height: 1.45;
+}
+
+/* ---------------------------------------------------------------------------
+   Sheets — ink header with cobalt rule, paper body (root modal idiom)
+--------------------------------------------------------------------------- */
+
+.sheet {
+  width: min(1040px, calc(100% - 2.5rem));
+  max-width: none;
+  max-height: calc(100dvh - 2.5rem);
+  overflow: hidden;
+  border: 0;
+  border-radius: var(--radius);
+  padding: 0;
+  background: var(--surface);
+  color: var(--ink);
+  font-size: 15px;
+  line-height: 1.65;
+  box-shadow: 0 30px 90px rgba(23, 27, 24, 0.34);
+}
+
+.sheet.is-compact {
+  width: min(760px, calc(100% - 2.5rem));
+}
+
+.sheet::backdrop,
+.case-modal::backdrop {
+  background: rgba(23, 27, 24, 0.62);
+  backdrop-filter: blur(4px);
+}
+
+.sheet[open] {
+  animation: case-modal-in 200ms ease;
+}
+
+.sheet-shell {
+  display: flex;
+  flex-direction: column;
+  max-height: calc(100dvh - 2.5rem);
+}
+
+.sheet-head {
+  display: flex;
+  align-items: flex-start;
+  justify-content: space-between;
+  gap: 1rem;
+  border-bottom: 3px solid var(--blue);
+  padding: 1.3rem 1.75rem 1.1rem;
+  background: var(--ink);
+  color: #fff;
+}
+
+.sheet-head > div {
+  max-width: var(--text-max);
+}
+
+.sheet-head h2 {
+  margin: 0 0 0.3rem;
+  color: #fff;
+  font-family: var(--display);
+  font-size: clamp(1.6rem, 3vw, 2.3rem);
+  font-variation-settings: "wdth" 96;
+  font-weight: 700;
+  letter-spacing: -0.04em;
+  line-height: 1;
+}
+
+.sheet-head .project-kicker {
+  margin-bottom: 0.4rem;
+  color: var(--tint-ink);
+}
+
+.sheet-head .project-subtitle {
+  margin: 0;
+  color: rgba(255, 255, 255, 0.78);
+  font-weight: 500;
+}
+
+.sheet-head .project-links {
+  margin-top: 0.8rem;
+}
+
+.sheet-head .project-links a {
+  border-color: rgba(255, 255, 255, 0.32);
+  color: #fff;
+}
+
+.sheet-head .project-links a:hover,
+.sheet-head .project-links a:focus-visible {
+  border-color: var(--tint-ink);
+  color: var(--tint-ink);
+}
+
+.sheet-close {
+  display: grid;
+  flex: 0 0 auto;
+  width: 40px;
+  height: 40px;
+  place-items: center;
+  border: 1px solid rgba(255, 255, 255, 0.3);
+  border-radius: 0;
+  padding: 0;
+  background: rgba(255, 255, 255, 0.08);
+  color: #fff;
+  font-size: 1.4rem;
+  line-height: 1;
+  cursor: pointer;
+  transition:
+    background 140ms ease,
+    border-color 140ms ease;
+}
+
+.sheet-close:hover,
+.sheet-close:focus-visible {
+  border-color: #fff;
+  background: rgba(255, 255, 255, 0.18);
+  outline: none;
+}
+
+.sheet-body {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr);
+  gap: 1.5rem;
+  overflow: auto;
+  padding: 1.25rem 1.75rem 1.75rem;
+}
+
+.sheet-body > p {
+  max-width: var(--text-max);
+}
+
+.sheet h3,
+.case-modal h3 {
+  margin-bottom: 0.45rem;
+  font-size: 1.38rem;
+  line-height: 1.25;
+}
+
+.sheet h4,
+.case-modal h4 {
+  margin-bottom: 0.55rem;
+  font-size: 0.98rem;
+}
+
+.sheet code,
+.case-modal code {
+  border: 1px solid var(--line);
+  border-radius: var(--radius-sm);
+  padding: 0.08rem 0.32rem;
+  background: rgba(23, 27, 24, 0.05);
+  font-size: 0.92em;
+}
+
+.sheet .mini-media {
+  min-height: 0;
+}
+
+.sheet .mini-media .media-button {
+  height: 100%;
+}
+
+.sheet .mini-media img {
+  min-height: 0;
+  aspect-ratio: 16 / 10;
+}
+
+/* ---------------------------------------------------------------------------
+   Responsive
+--------------------------------------------------------------------------- */
+
+@media (max-width: 1180px) {
+  .folio-grid {
+    grid-template-columns: repeat(3, minmax(0, 1fr));
+  }
+}
+
+@media (max-width: 900px) {
+  html,
+  body {
+    height: auto;
+  }
+
+  .app {
+    height: auto;
+    overflow: visible;
+  }
+
+  .masthead {
+    flex-direction: column;
+    align-items: flex-start;
+    gap: 0.5rem;
+    padding: 1rem 1rem 0.8rem;
+  }
+
+  .masthead-side {
+    justify-items: start;
+    text-align: left;
+  }
+
+  .chrono {
+    grid-template-columns: 1fr;
+    padding: 0.7rem 1rem;
+  }
+
+  .chrono-side {
+    justify-items: start;
+    text-align: left;
+  }
+
+  .chrono-hint {
+    display: none;
+  }
+
+  .chrono-main {
+    max-width: none;
+  }
+
+  .chrono-grid {
+    --chrono-label: 84px;
+  }
+
+  /* 모바일 폭에서는 연표가 잘려 보이므로 아예 감춘다 */
+  @media (max-width: 640px) {
+    .chrono {
+      display: none;
+    }
+  }
+
+  .workspace {
+    display: block;
+  }
+
+  .rail {
+    position: sticky;
+    top: 0;
+    z-index: 30;
+    flex-direction: row;
+    overflow: auto;
+    border-right: 0;
+    border-bottom: 1px solid rgba(23, 27, 24, 0.2);
+    padding: 0.4rem 0.75rem;
+    background: var(--paper);
+    scrollbar-width: none;
+  }
+
+  .rail-label,
+  .rail-note,
+  .rail-index,
+  .rail-foot {
+    display: none;
+  }
+
+  .rail-list {
+    display: flex;
+    gap: 0.25rem;
+  }
+
+  .rail-link {
+    display: block;
+    padding: 0.45rem 0.8rem;
+    white-space: nowrap;
+  }
+
+  .stage {
+    overflow: visible;
+    padding: 1rem;
+  }
+
+  .intro {
+    grid-template-columns: 1fr;
+    padding: 1.2rem 1.2rem;
+  }
+
+  .hero-media {
+    display: none;
+  }
+
+  .ama-panel,
+  .ai-card,
+  .cards,
+  .work-rows {
+    grid-template-columns: 1fr;
+  }
+
+  .skills {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+
+  .work-item {
+    grid-template-columns: 1fr;
+    gap: 0.45rem;
+  }
+
+  .work-side {
+    justify-content: flex-start;
+  }
+
+  .folio-grid {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+
+  .sheet-head {
+    padding: 1.1rem 1.1rem 0.9rem;
+  }
+
+  .sheet-body {
+    padding: 1rem 1.1rem 1.25rem;
+  }
+
+  .project-grid,
+  .compact-grid,
+  .three-grid {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+
+  .campaign-block {
+    grid-template-columns: 1fr;
+  }
+}
+
+@media (max-width: 760px) {
+  .sheet,
+  .sheet.is-compact {
+    width: calc(100% - 0.75rem);
+    max-height: calc(100dvh - 0.75rem);
+  }
+
+  .sheet-shell {
+    max-height: calc(100dvh - 0.75rem);
+  }
+
+  .case-study-list {
+    grid-template-columns: 1fr;
+  }
+
+  .case-study-trigger {
+    grid-template-columns: 1fr;
+    gap: 0.75rem;
+    padding: 1rem;
+  }
+
+  .case-study-trigger.is-wide,
+  .case-study-trigger.is-compact,
+  .case-study-trigger.is-full {
+    grid-column: 1 / -1;
+  }
+
+  .case-study-trigger-action {
+    justify-self: start;
+  }
+
+  .media-strip {
+    grid-auto-columns: minmax(170px, 70vw);
+  }
+}
+
+@media (max-width: 560px) {
+  .skills,
+  .folio-grid,
+  .project-grid,
+  .compact-grid,
+  .three-grid {
+    grid-template-columns: 1fr;
+  }
+
+  .fact {
+    grid-template-columns: 1fr;
+    gap: 0.1rem;
+  }
+}
+
+/* ===========================================================================
+   Document components lifted from the root stylesheet (current design)
+   =========================================================================== */
+
+.project-kicker,
+.project-subtitle,
+.role {
+  color: var(--muted);
+}
+
+.project-kicker {
+  margin-bottom: 0.3rem;
+  font-family: var(--mono);
+  font-size: 0.64rem;
+  font-weight: 500;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+}
+
+.project-subtitle {
+  margin-bottom: 0;
+  font-weight: 700;
+}
+
+.project-links {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.65rem;
+}
+
+.project-links a {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  min-height: 34px;
+  border: 1px solid var(--line);
+  padding: 0 0.9rem;
+  color: var(--ink);
+  font-family: var(--mono);
+  font-size: 0.66rem;
+  font-weight: 600;
+  letter-spacing: 0.06em;
+  text-transform: uppercase;
+  transition:
+    border-color 140ms ease,
+    color 140ms ease;
+}
+
+.project-links a:hover,
+.project-links a:focus-visible {
+  border-color: var(--blue);
+  color: var(--blue);
+  outline: none;
+}
+
+.case-study-list {
+  display: grid;
+  grid-template-columns: repeat(6, minmax(0, 1fr));
+  gap: 0.8rem;
+}
+
+.impact-list {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.5rem;
+}
+
+.impact-list span,
+.tag-cloud span {
+  display: inline-flex;
+  align-items: center;
+  min-height: 28px;
+  border: 1px solid var(--line);
+  padding: 0.28rem 0.6rem;
+  background: #fff;
+  color: var(--ink);
+  font-size: 0.8rem;
+  font-weight: 600;
+}
+
+.impact-list span {
+  border-color: transparent;
+  background: var(--tint);
+  font-weight: 700;
+}
+
+.project-grid {
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  gap: 1.2rem;
+  border-top: 1px solid var(--line);
+  padding-top: 1.2rem;
+}
+
+.project-grid ul {
+  margin: 0;
+  padding-left: 1.1rem;
+}
+
+.project-grid li + li {
+  margin-top: 0.42rem;
+}
+
+.tag-cloud {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.45rem;
+  margin-bottom: 0;
+}
+
+.media-strip {
+  display: grid;
+  grid-auto-columns: minmax(180px, 230px);
+  grid-auto-flow: column;
+  gap: 1rem;
+  overflow-x: auto;
+  padding: 0.25rem 0 0.75rem;
+  scrollbar-width: thin;
+}
+
+.media-button {
+  display: block;
+  width: 100%;
+  min-width: 0;
+  overflow: hidden;
+  border: 1px solid var(--line);
+  border-radius: var(--radius);
+  padding: 0;
+  background: var(--paper);
+  cursor: zoom-in;
+}
+
+.media-button:focus-visible {
+  outline: 2px solid var(--blue);
+  outline-offset: 2px;
+}
+
+.media-button img {
+  width: 100%;
+  height: 100%;
+  object-fit: cover;
+  transition: transform 180ms ease;
+}
+
+.media-button:hover img {
+  transform: scale(1.025);
+}
+
+.contain-shot {
+  background: #fff;
+}
+
+.contain-shot img {
+  object-fit: contain;
+  background: #fff;
+}
+
+.phone-frame {
+  aspect-ratio: 520 / 1128;
+  background: var(--ink);
+}
+
+.single-phone {
+  width: min(260px, 100%);
+}
+
+.media-grid {
+  display: grid;
+  gap: 1rem;
+}
+
+.compact-grid {
+  grid-template-columns: repeat(4, minmax(0, 1fr));
+}
+
+.three-grid {
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+}
+
+.full-shot {
+  aspect-ratio: 16 / 9;
+}
+
+.wide-shot {
+  aspect-ratio: 16 / 9;
+}
+
+.tall-shot {
+  aspect-ratio: 3 / 4;
+}
+
+.square-shot {
+  aspect-ratio: 1 / 1;
+}
+
+.tall-desktop-shot {
+  aspect-ratio: 4 / 5;
+}
+
+.campaign-block {
+  display: grid;
+  grid-template-columns: minmax(240px, 0.36fr) minmax(0, 1fr);
+  gap: 1.2rem;
+  border-top: 1px solid var(--line);
+  padding-top: 1.5rem;
+}
+
+.campaign-block > div:first-child {
+  max-width: 440px;
+}
+
+.mini-media {
+  display: grid;
+  overflow: hidden;
+  min-height: 170px;
+  border-radius: var(--radius);
+  background: var(--paper);
+}
+
+.mini-media img {
+  width: 100%;
+  height: 100%;
+  min-height: 170px;
+  object-fit: cover;
+}
+
+.two-up {
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+}
+
+.case-study-trigger {
+  position: relative;
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) auto;
+  gap: 0.85rem 1.5rem;
+  width: 100%;
+  border: 1px solid var(--line);
+  border-left: 1px solid var(--edge-2);
+  border-radius: var(--radius);
+  padding: 1.15rem 1.25rem;
+  background: rgba(243, 244, 239, 0.66);
+  color: var(--ink);
+  font: inherit;
+  text-align: left;
+  cursor: pointer;
+  transition:
+    border-color 180ms ease,
+    background 180ms ease;
+}
+
+.case-study-trigger.is-wide {
+  grid-column: span 3;
+  grid-template-columns: 1fr;
+}
+
+.case-study-trigger.is-full {
+  grid-column: 1 / -1;
+}
+
+.case-study-trigger.is-compact {
+  grid-column: span 3;
+  grid-template-columns: 1fr;
+  align-content: start;
+  padding: 1rem;
+}
+
+.case-study-trigger.is-wide .case-study-trigger-action,
+.case-study-trigger.is-compact .case-study-trigger-action {
+  justify-self: start;
+}
+
+.case-study-trigger.is-highlighted {
+  border-left: 3px solid var(--blue);
+}
+
+.case-study-trigger.is-highlighted .case-study-trigger-index {
+  background: var(--blue);
+  color: #fff;
+}
+
+.case-study-trigger:hover,
+.case-study-trigger:focus-visible {
+  border-color: var(--blue);
+  background: rgba(255, 255, 255, 0.55);
+  outline: none;
+}
+
+.case-study-trigger:focus-visible {
+  outline: 2px solid var(--blue);
+  outline-offset: 2px;
+}
+
+.case-study-trigger-meta {
+  grid-column: 1 / -1;
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 0.45rem 0.7rem;
+  color: var(--muted);
+  font-family: var(--mono);
+  font-size: 0.64rem;
+  font-weight: 500;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+}
+
+.case-study-trigger-index {
+  display: inline-flex;
+  align-items: center;
+  min-height: 22px;
+  padding: 0.15rem 0.45rem;
+  background: var(--ink);
+  color: var(--tint-ink);
+}
+
+.case-study-trigger-copy {
+  display: grid;
+  gap: 0.22rem;
+  max-width: 720px;
+}
+
+.case-study-trigger-copy strong {
+  font-size: clamp(1.12rem, 2vw, 1.35rem);
+  line-height: 1.35;
+}
+
+.case-study-trigger-copy > span {
+  color: var(--fg-2);
+  font-size: 0.93rem;
+  line-height: 1.55;
+}
+
+.case-study-trigger-action {
+  z-index: 1;
+  align-self: end;
+  color: var(--blue);
+  font-size: 0.88rem;
+  font-weight: 700;
+  white-space: nowrap;
+}
+
+.case-modal {
+  width: min(1120px, calc(100% - 2rem));
+  max-width: none;
+  max-height: calc(100dvh - 2rem);
+  overflow: hidden;
+  border: 0;
+  border-radius: var(--radius);
+  padding: 0;
+  background: var(--surface);
+  color: var(--ink);
+  box-shadow: 0 30px 90px rgba(23, 27, 24, 0.34);
+}
+
+.case-modal[open] {
+  animation: case-modal-in 220ms ease-out;
+}
+
+.case-modal-shell {
+  display: grid;
+  grid-template-rows: auto auto minmax(0, 1fr) auto;
+  max-height: calc(100dvh - 2rem);
+}
+
+.case-modal-header {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) auto;
+  gap: 1.5rem;
+  border-bottom: 3px solid var(--blue);
+  padding: 1.45rem clamp(1.2rem, 4vw, 2.4rem);
+  background: var(--ink);
+  color: #fff;
+}
+
+.case-modal-header > div {
+  max-width: 850px;
+}
+
+.case-modal-header h2 {
+  margin-bottom: 0.5rem;
+  color: #fff;
+  font-size: clamp(1.75rem, 3.6vw, 2.7rem);
+  line-height: 1.12;
+}
+
+.case-modal-header p {
+  max-width: 760px;
+  margin-bottom: 0;
+  color: rgba(255, 255, 255, 0.76);
+}
+
+.case-modal-header .case-modal-kicker {
+  margin-bottom: 0.48rem;
+  color: var(--tint-ink);
+  font-family: var(--mono);
+  font-size: 0.64rem;
+  font-weight: 500;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+}
+
+.case-modal-close {
+  display: grid;
+  width: 42px;
+  height: 42px;
+  place-items: center;
+  border: 1px solid rgba(255, 255, 255, 0.3);
+  border-radius: 0;
+  padding: 0;
+  background: rgba(255, 255, 255, 0.1);
+  color: #fff;
+  font: inherit;
+  font-size: 1.7rem;
+  line-height: 1;
+  cursor: pointer;
+}
+
+.case-modal-close:hover,
+.case-modal-close:focus-visible {
+  border-color: #fff;
+  background: rgba(255, 255, 255, 0.18);
+  outline: none;
+}
+
+.case-modal-content {
+  overflow-y: auto;
+  padding: 0 clamp(1.2rem, 4vw, 2.4rem) 2rem;
+  overscroll-behavior: contain;
+}
+
+.case-narrative .case-section {
+  padding: clamp(1.7rem, 4vw, 2.6rem) 0;
+}
+
+.case-narrative.is-compact .case-section {
+  padding-block: clamp(1.45rem, 3vw, 2.1rem);
+}
+
+.case-narrative .case-section[hidden] {
+  display: none;
+}
+
+.case-narrative .case-section.is-entering {
+  animation: step-in 220ms ease;
+}
+
+@keyframes step-in {
+  from {
+    opacity: 0;
+    transform: translateY(6px);
+  }
+
+  to {
+    opacity: 1;
+    transform: none;
+  }
+}
+
+.case-section-header {
+  max-width: 850px;
+  margin-bottom: 1.2rem;
+}
+
+.case-section-header h3 {
+  max-width: 800px;
+  margin: 0 0 0.6rem;
+  font-size: clamp(1.35rem, 2.7vw, 1.9rem);
